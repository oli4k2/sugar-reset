rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // ================================
    // HELPER FUNCTIONS
    // ================================
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(uid) {
      return request.auth.uid == uid;
    }
    
    // Check if user is an admin (exists in admins collection)
    function isAdmin() {
      return exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    
    // ================================
    // USER PROFILES
    // ================================
    
    match /users/{userId} {
      // Anyone authenticated can read basic user info (for search)
      allow read: if isAuthenticated();
      
      // Helper function to validate display name (no dangerous characters)
      // Note: Firestore rules have limited regex support, so we check for basic patterns
      // Client-side sanitization provides the main protection
      function isValidDisplayName(name) {
        return name is string &&
               name.size() > 0 &&
               name.size() <= 50;
               // Additional character validation is handled client-side
               // Firestore rules provide basic length validation as a safety net
      }
      
      // Only the user can write their own profile
      allow create: if isOwner(userId);
      // Allow update but prevent username changes (username is immutable for GDPR compliance)
      // Also validate displayName if it's being updated
      allow update: if isOwner(userId) && 
        (!('username' in request.resource.data) || 
         request.resource.data.username == resource.data.username) &&
        (!('usernameLower' in request.resource.data) || 
         request.resource.data.usernameLower == resource.data.usernameLower) &&
        (!('displayName' in request.resource.data) || 
         isValidDisplayName(request.resource.data.displayName));
      allow delete: if isOwner(userId);
      
      // Friends subcollection
      match /friends/{friendId} {
        // User can read their own friends
        allow read: if isOwner(userId);
        
        // Allow user to manage their own friends list (isOwner)
        // AND allow other users to add THEMSELVES to this user's friend list (for accepting requests)
        allow create: if isOwner(userId) || (isAuthenticated() && friendId == request.auth.uid);
        allow delete: if isOwner(userId) || (isAuthenticated() && friendId == request.auth.uid);
        
        // No updates needed - just create/delete
        allow update: if false;
      }
    }
    
    // ================================
    // USER STATS (Public for leaderboard)
    // ================================
    
    match /userStats/{userId} {
      // Anyone authenticated can read (for leaderboard/friend stats)
      allow read: if isAuthenticated();
      
      // Only the user can write their own stats
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
    
    // ================================
    // FRIEND REQUESTS
    // ================================
    
    match /friendRequests/{requestId} {
      // Both sender and receiver can read
      allow read: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      
      // Sender can create a request
      allow create: if isAuthenticated() && 
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.status == 'pending';
      
      // Receiver can update status (accept/decline)
      allow update: if isAuthenticated() && 
        resource.data.toUid == request.auth.uid &&
        request.resource.data.status in ['accepted', 'declined'];
      
      // Either party can delete (cancel/cleanup)
      allow delete: if isAuthenticated() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }
    
    // ================================
    // COMMUNITY POSTS
    // ================================
    
    match /posts/{postId} {
      // Anyone authenticated can read posts
      allow read: if isAuthenticated();
      
      // Helper function to validate post title
      // Note: Character validation is primarily handled client-side
      // Firestore rules provide length validation as a safety net
      function isValidPostTitle(title) {
        return title is string &&
               title.size() > 0 &&
               title.size() <= 140;
      }
      
      // Helper function to validate post content
      // Note: XSS prevention is primarily handled client-side via sanitization
      // Firestore rules provide length validation as a safety net
      function isValidPostContent(content) {
        return content is string &&
               content.size() > 0 &&
               content.size() <= 5000;
      }
      
      // Authenticated users can create posts with strict schema validation
      allow create: if isAuthenticated() && 
        request.resource.data.authorId == request.auth.uid &&
        isValidPostTitle(request.resource.data.title) &&
        isValidPostContent(request.resource.data.content) &&
        // Verify common fields
        (!('tags' in request.resource.data) || request.resource.data.tags is list);
      
      // Author can update their own post (but not critical fields)
      // OR any authenticated user can update ONLY the commentCount or upvotes fields
      allow update: if isAuthenticated() && (
        // Author can update most fields
        (resource.data.authorId == request.auth.uid &&
         request.resource.data.authorId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['createdAt']))
        ||
        // Any authenticated user can only update commentCount or upvotes (for voting/commenting)
        (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['commentCount', 'upvotes']))
      );
      
      // Author or admin can delete a post
      allow delete: if isAuthenticated() && 
        (resource.data.authorId == request.auth.uid || isAdmin());
      
      // Votes subcollection
      match /votes/{voteId} {
        allow read: if isAuthenticated();
        allow write: if isAuthenticated() && 
           // User can only modify their own vote document
           voteId == request.auth.uid;
      }
      
      // Comments subcollection
      match /comments/{commentId} {
        allow read: if isAuthenticated();
        // Helper function to validate comment content
        // Note: XSS prevention is primarily handled client-side via sanitization
        // Firestore rules provide length validation as a safety net
        function isValidCommentContent(content) {
          return content is string &&
                 content.size() > 0 &&
                 content.size() <= 1000;
        }
        
        // Create comment with validation
        allow create: if isAuthenticated() && 
          request.resource.data.authorId == request.auth.uid &&
          isValidCommentContent(request.resource.data.content);
        
        // Author can update their own comments (for name propagation)
        allow update: if isAuthenticated() && 
          resource.data.authorId == request.auth.uid;
          
        // Author or admin can delete a comment
        allow delete: if isAuthenticated() && 
          (resource.data.authorId == request.auth.uid || isAdmin());
      }
    }
    
    // ================================
    // SOS EVENTS (for history)
    // ================================
    
    match /sosEvents/{eventId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
    }
    
    // ================================
    // COMMUNITY STATS (Read-only aggregate)
    // ================================
    
    match /communityStats/{docId} {
      // Anyone authenticated can read community-wide stats
      allow read: if isAuthenticated();
      
      // SECURITY: Block all client-side writes to global stats
      // Updates must be performed by Cloud Functions
      allow write: if false;
    }
    
    // ================================
    // REFERRALS
    // ================================
    
    match /referrals/{userId} {
      // Users can read their own referral data
      allow read: if isAuthenticated() && isOwner(userId);
      
      // Users can create their own referral data
      allow create: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.referralCode is string &&
        request.resource.data.referralCount == 0 &&
        request.resource.data.referredUsers == [];
      
      // Users can update their own referral data (for incrementing counts, etc.)
      // But they cannot change their referralCode or referredBy
      allow update: if isAuthenticated() && isOwner(userId) &&
        request.resource.data.referralCode == resource.data.referralCode &&
        (!('referredBy' in request.resource.data) || request.resource.data.referredBy == resource.data.referredBy);
      
      // Users cannot delete their referral data
      allow delete: if false;
      
      // Allow querying by referralCode (for finding referrers)
      // This is needed for the findUserByReferralCode function
      // Note: Firestore rules don't directly control queries, but we ensure
      // that only authenticated users can read referral data
    }
    
    // ================================
    // ADMINS (Content Moderation)
    // ================================
    
    match /admins/{userId} {
      // Any authenticated user can check if they are an admin
      // This allows the app to show/hide admin features
      allow read: if isAuthenticated();
      
      // SECURITY: Block all client-side writes to admin collection
      // Admin users must be added manually via Firebase Console
      // To add an admin: Create a document with the user's UID as the document ID
      allow write: if false;
    }
  }
}
