{
  "expo": {
    "name": "Craveless",
    "slug": "sugar-reset",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./src/public/craveless_app_icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "scheme": "craveless",
    "splash": {
      "image": "./assets/images/welcome-splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#E8A857"
    },
    "ios": {
      "icon": "./src/public/craveless_app_icon.png",
      "supportsTablet": true,
      "bundleIdentifier": "com.sugarreset.app",
      "appleTeamId": "LX5566JXPP",
      "infoPlist": {
        "NSHealthShareUsageDescription": "Craveless needs access to read your health data to provide personalized insights and track your wellness journey.",
        "NSHealthUpdateUsageDescription": "Craveless needs access to update your health data with your logged nutrition.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./src/public/craveless_app_icon.png",
        "backgroundColor": "#0D0F12"
      },
      "package": "com.craveless.app",
      "googleServicesFile": "./google-services.json",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.health.READ_NUTRITION",
        "android.permission.health.WRITE_NUTRITION"
      ]
    },
    "web": {
      "favicon": "./src/public/craveless_app_icon.png"
    },
    "extra": {
      "eas": {
        "projectId": "830fe8e5-e8bb-4d50-8695-7e2a736e75dd"
      }
    },
    "owner": "victorhaugaard",
    "plugins": [
      "expo-font",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.68240123690-a3vhmp88g4ng97npdpgkvkbgrspj4hfr"
        }
      ],
      "expo-localization"
    ]
  }
}
